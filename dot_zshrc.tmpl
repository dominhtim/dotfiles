# ~/.zshrc — managed by chezmoi. Edit with `chezmoi edit ~/.zshrc`.

# Powerlevel10k instant prompt. Anything that reads input (password
# prompts, [y/n]) must go ABOVE this block.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export PATH="$HOME/.local/bin:$PATH"   # chezmoi itself lives here
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# --- completion ---
autoload -U compinit
zstyle ':completion:*' menu select
zmodload zsh/complist
compinit
_comp_options+=(globdots)            # include dotfiles in tab-completion

DISABLE_UPDATE_PROMPT="true"
export UPDATE_ZSH_DAYS=13
ENABLE_CORRECTION="true"

plugins=(
  git
  sudo                                # Esc twice re-runs the last command with sudo
  extract                             # `extract <archive>` for any archive format
  fzf
  zsh-autosuggestions
  zsh-syntax-highlighting             # must stay LAST, it breaks bindings after it
)

source $ZSH/oh-my-zsh.sh

# --- history ---
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY          # timestamps
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE         # don't record lines starting with a space
setopt HIST_VERIFY
setopt SHARE_HISTORY             # share history across open sessions

# --- editor ---
export EDITOR='nvim'
export VISUAL='nvim'

# --- aliases ---
alias ls='ls -Fh --color=auto'
alias la='ls -A'
alias ll='ls -lAh'
alias cp='cp -iv --reflink=auto'
alias mv='mv -iv'
alias rm='rm -v'
alias mkdir='mkdir -pv'
alias grep='grep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias vim='nvim'
alias vi='nvim'
alias reload='exec zsh'
alias dotfiles='chezmoi cd'

{{- /* One source, correct on every OS it's applied to. */}}
{{- if eq .chezmoi.os "darwin" }}
alias pbc='pbcopy'
alias pbp='pbpaste'
{{- else }}
alias pbc='xclip -selection clipboard'
alias pbp='xclip -selection clipboard -o'
{{- end }}

# --- fzf: Ctrl+R history, Ctrl+T files, ** completion ---
# completion.zsh must be sourced explicitly; no distro package does it, and
# it needs the compinit above. See CLAUDE.md for the path choice.
[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && source /usr/share/doc/fzf/examples/key-bindings.zsh
[ -f /usr/share/doc/fzf/examples/completion.zsh ] && source /usr/share/doc/fzf/examples/completion.zsh

# --- prompt ---
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# --- local machine overrides, never committed ---
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
